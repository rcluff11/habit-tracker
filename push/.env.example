# Copy to push/.env on the server that runs the sender. Never commit push/.env.
# PocketBase address as seen from the sender (same machine: http://127.0.0.1:8090)
PB_URL=http://127.0.0.1:8090
# A PocketBase superuser the sender logs in as (create a dedicated one)
PB_EMAIL=push-sender@example.com
PB_PASSWORD=change-me
# Contact for push services, mailto: or https: URL
VAPID_SUBJECT=mailto:you@example.com
# Generate once with: npx web-push generate-vapid-keys
# The PUBLIC key also goes in Netlify as VITE_VAPID_PUBLIC_KEY
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
