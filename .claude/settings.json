{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(npm run test:stats)",
      "Bash(npm run test:reminders)",
      "Bash(npm run test:api)",
      "Bash(npm run build)"
    ],
    "ask": [
      "Bash(git push *main*)",
      "Bash(git push *master*)",
      "Bash(git push *production*)",
      "Bash(git push *release*)",
      "Bash(git push *trunk*)",
      "Bash(git push *--force*)",
      "Bash(git push * -f*)",
      "Bash(git reset:*)",
      "Bash(rm:*)",
      "Bash(npm install:*)",
      "Bash(npm run push:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(rm -rf /*)",
      "Read(./node_modules/**)",
      "Read(./dist/**)",
      "Read(./package-lock.json)",
      "Read(./pocketbase/pb_data/**)",
      "Read(./push/.env)",
      "Read(./.env)",
      "Read(./.env.local)"
    ]
  }
}
